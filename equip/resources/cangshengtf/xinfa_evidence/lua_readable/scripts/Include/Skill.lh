    L4_304 = 7
    L5_305 = 6
  end
  if A1_301.GetBuff(9724, L5_305) then
    L3_303 = L3_303 + A1_301.GetBuff(9724, L5_305).nStackNum
    A1_301.DelGroupBuff(9724, L5_305)
  end
  A1_301.AddBuff(A0_300.dwID, A0_300.nLevel, 9724, L4_304, 0, 0, L3_303)
  return true
end
function SkillAddZiJiHaoZhen(A0_306)
  if not A0_306 then
    return false
  end
  if A0_306.GetSkillLevel(42300) == 1 then
    return SkillAddHaoZhen(A0_306, A0_306, 1)
  end
  return false
end
function GbRageChange(A0_307)
  if not GetPlayer(A0_307) then
    return
  end
  GetPlayer(A0_307).DelBuffByID(30400)
  if GetPlayer(A0_307).GetActualKungfuMountID() ~= 10268 or GetPlayer(A0_307).GetMapID() == 709 then
    return
  end
  if GetPlayer(A0_307).nCurrentRage >= 3 then
    if not GetPlayer(A0_307).IsHaveBuff(6383, 0) then
      if not GetPlayer(A0_307).IsHaveBuff(30334, 1) then
        GetPlayer(A0_307).AddBuff(GetPlayer(A0_307).dwID, GetPlayer(A0_307).nLevel, 6383, 1)
      end
    elseif not GetPlayer(A0_307).IsHaveBuff(30333, 1) and not GetPlayer(A0_307).IsHaveBuff(30334, 1) then
      GetPlayer(A0_307).AddBuff(GetPlayer(A0_307).dwID, GetPlayer(A0_307).nLevel, 30333, 1)
    end
  else
    GetPlayer(A0_307).DelBuffByID(6383)
    RemoteCallToClient(GetPlayer(A0_307).dwID, "OnSkillReplace", 5272, 5268, 1, 5268)
  end
  if not GetPlayer(A0_307).IsHaveBuff(30334, 0) then
    GetPlayer(A0_307).AddBuff(GetPlayer(A0_307).dwID, GetPlayer(A0_307).nLevel, 30499, 1)
    GetPlayer(A0_307).AddBuff(GetPlayer(A0_307).dwID, GetPlayer(A0_307).nLevel, 30500, 1)
    GetPlayer(A0_307).AddBuff(GetPlayer(A0_307).dwID, GetPlayer(A0_307).nLevel, 30624, 1)
    GetPlayer(A0_307).DelBuff(30499, 1)
    GetPlayer(A0_307).DelBuff(30500, 1)
    GetPlayer(A0_307).DelBuff(30624, 1)
  end
  GetPlayer(A0_307).DelBuffByID(20939)
  GetPlayer(A0_307).DelGroupBuff(30400, 1)
  if GetPlayer(A0_307).nCurrentRage >= 1 then
    GetPlayer(A0_307).AddBuff(GetPlayer(A0_307).dwID, GetPlayer(A0_307).nLevel, 30400, 1)
  end
end
function ModityCDToUI(A0_308, A1_309, A2_310, A3_311)
  do return end
  if not A0_308 then
    return
  end
  if not A0_308.GetScene() then
    return
  end
  if GetGameVersion() and GetGameVersion().VersionEx == "expjjc" and A0_308.GetScene().bIsArenaMap then
    for _FORV_10_ = 1, #A0_308.GetScene().GetAllPlayer() do
      if GetPlayer(A0_308.GetScene().GetAllPlayer()[_FORV_10_]) and GetPlayer(A0_308.GetScene().GetAllPlayer()[_FORV_10_]).GetBuff(10709, 0) then
        if A2_310 == 0 then
          A2_310 = nil
        end
        RemoteCallToClient(GetPlayer(A0_308.GetScene().GetAllPlayer()[_FORV_10_]).dwID, "CallUIGlobalFunction", "FireUIEvent", "ON_SKILL_CD_NOTIFY", A0_308.dwID, A1_309, A2_310)
      end
    end
  elseif A0_308.GetScene().bIsArenaMap then
    for _FORV_10_ = 1, #A0_308.GetScene().GetAllObserver() do
      if GetPlayer(A0_308.GetScene().GetAllObserver()[_FORV_10_]) then
        if A2_310 == 0 then
          A2_310 = nil
        end
        RemoteCallToClient(GetPlayer(A0_308.GetScene().GetAllObserver()[_FORV_10_]).dwID, "CallUIGlobalFunction", "FireUIEvent", "ON_SKILL_CD_NOTIFY", A0_308.dwID, A1_309, A2_310)
      end
    end
  end
end
