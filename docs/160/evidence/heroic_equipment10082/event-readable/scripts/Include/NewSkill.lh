tOrangeWeaponSceneMode = {
  DISABLED = 0,
  ACTIVE = 1,
  PASSIVE = 2
}
function GetOrangeWeaponSceneMode(A0_397)
  if not A0_397 then
    return tOrangeWeaponSceneMode.DISABLED
  end
  if not A0_397.GetScene() then
    return tOrangeWeaponSceneMode.DISABLED
  end
  if A0_397.GetScene().bIsArenaMap then
    return tOrangeWeaponSceneMode.DISABLED
  end
  if A0_397.GetScene().dwMapID == 293 then
    return tOrangeWeaponSceneMode.DISABLED
  end
  if A0_397.GetScene().nType == MAP_TYPE.DUNGEON or _UPVALUE0_[A0_397.GetScene().dwMapID] or A0_397.GetScene().dwMapID == 74 or A0_397.GetScene().dwMapID == 3 then
    return tOrangeWeaponSceneMode.ACTIVE
  end
  return tOrangeWeaponSceneMode.PASSIVE
end
